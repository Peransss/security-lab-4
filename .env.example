# Contoh konfigurasi environment untuk SecurePay (DevOps).
# Salin ke .env untuk lokal: copy .env.example .env (Windows) / cp .env.example .env
# JANGAN isi nilai asli di file ini. Nilai asli hanya di secret manager / GitHub Secrets.
# File .env sudah di-ignore via .gitignore.

# Secret untuk menandatangani JWT (pengganti config.jwtSecret)
JWT_SECRET=

# API key payment gateway (pengganti config.paymentGatewayApiKey)
PAYMENT_GATEWAY_API_KEY=

# Port opsional (default 3000)
PORT=
